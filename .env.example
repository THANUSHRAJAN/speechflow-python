# Copy to speech-service/.env (never commit the real file).

# Model size: tiny | base | small | medium | large-v3   (all multilingual)
# "small" is the default: good Hindi/English accuracy, ~1.5-2 GB RAM on CPU.
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# int8 works everywhere (best for CPU). On an NVIDIA GPU use float16.
WHISPER_COMPUTE_TYPE=int8
# Where model weights are downloaded (git-ignored).
WHISPER_MODEL_DIR=./models
# 1 = greedy decoding (fastest, ideal for live use). 5 = more accurate, slower.
WHISPER_BEAM_SIZE=1

HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Streaming behaviour (seconds)
CHUNK_INTERVAL_SECONDS=1.5
STABILITY_MARGIN_SECONDS=1.0
MAX_BUFFER_SECONDS=15
OVERLAP_SECONDS=1.0
